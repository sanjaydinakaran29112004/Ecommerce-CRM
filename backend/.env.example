PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration (MongoDB Atlas / Local)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ecommerce_crm?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/ecommerce_crm
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce_crm

# JWT Configuration
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_production_min32chars
JWT_ACCESS_EXPIRY=1d
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production_min32chars
JWT_REFRESH_EXPIRY=30d

# Security
BCRYPT_SALT_ROUNDS=10

